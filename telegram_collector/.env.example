# Bothost provides BOT_TOKEN after you enter the BotFather token in its panel.
BOT_TOKEN=

# Optional AI parser. The models are tried in order and all defaults are free.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,openrouter/free
# off | always | fallback
LLM_MODE=always

# Keep enabled only in the private test group. Disable before production.
TEST_REPLY_MODE=true

# Empty means every chat where the bot is present. After /chatid, lock it down.
ALLOWED_CHAT_IDS=

# Optional Telegram user IDs allowed to run /status and /chatid.
ADMIN_USER_IDS=

SOURCE_TIMEZONE=Asia/Dushanbe
LOG_LEVEL=INFO
DATA_DIR=/app/data

# Optional real-account forwarder. Keep disabled until a private StringSession
# has been created locally and source/target chat IDs have been reviewed.
USERBOT_ENABLED=false
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION=
USERBOT_SOURCE_CHAT_IDS=
USERBOT_TARGET_CHAT_ID=
USERBOT_FORWARD_DELAY_SECONDS=1.0
